# 服务运行端口
PORT=3000

# 自定义项目存储目录 (可选，留空则默认保存在 ~/.roadmap-skill/projects)
# ROADMAP_STORAGE_DIR=./data/projects

# 用户认证与多租户 JWT 签名密钥 (建议生产环境修改)
JWT_SECRET=roadmap-skill-secret-key-change-in-production

# ==========================================
# AI 导师默认服务端配置 (可选，前端用户也可在界面自行配置私有 Key)
# ==========================================
# 默认大模型 Base URL 与模型名称
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# 各常见厂商 API 秘钥备用 (前端未输入 Key 时作为服务端默认兜底)
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
# SILICONFLOW_API_KEY=sk-...
